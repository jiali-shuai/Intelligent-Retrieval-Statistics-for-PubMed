# PubMed 文献分析系统配置文件示例
# 复制此文件为 .env 并按需填写

# NCBI E-utilities（配置后可提升请求频率上限 3次/秒 -> 10次/秒）
NCBI_API_KEY=
NCBI_EMAIL=your_email@example.com

# 大模型（用于关键词翻译扩展与中文综述生成；不配置则自动使用本地降级方案）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
# 深度思考强度（low/high/max），仅综述撰写开启；其余环节关闭以提速
DEEPSEEK_THINKING_EFFORT=high

# 检索参数
MAX_FETCH=300      # 单次最多解析的文献数
RECENT_YEARS=5     # “近 N 年”口径
TOP_PAPERS=100     # 影响力 Top 文献数量

# MySQL 数据库（可选；DB_HOST/DB_NAME 为空则跳过文献入库）
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
